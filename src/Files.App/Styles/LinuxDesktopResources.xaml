<!--
	Linux desktop (Uno Skia) resource overrides. Merged last in App.xaml so they win over the WinUI defaults.
	Segoe UI / Segoe Fluent Icons are not redistributable, so text uses the OFL-licensed Selawik (Segoe UI metrics)
	and icons use Uno.Fonts.Fluent (Segoe Fluent Icons code points). See docs/linux-port/third-party-fonts.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Linux/selawk.ttf#Selawik</FontFamily>
	<FontFamily x:Key="SymbolThemeFontFamily">ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf#Symbols</FontFamily>
	<FontFamily x:Key="Files.Linux.IconFontFamily">ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf#Symbols</FontFamily>
	<FontFamily x:Key="Files.Linux.MonospaceFontFamily">DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>

	<!--  ListViewItem template: Uno's default presenter paints no selected or hover background, so draw them here  -->
	<ControlTemplate x:Key="Files.ListViewItemTemplate" TargetType="ListViewItem">
		<Grid x:Name="RootGrid" Background="Transparent">
			<Border
				x:Name="SelectionBackground"
				Margin="2,1"
				Background="Transparent"
				BorderBrush="Transparent"
				BorderThickness="1"
				CornerRadius="{TemplateBinding CornerRadius}"
				IsHitTestVisible="False" />
			<Border
				x:Name="SelectionIndicator"
				Width="3"
				Height="16"
				Margin="4,0,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				Background="{ThemeResource Files.Item.AccentBrush}"
				CornerRadius="1.5"
				IsHitTestVisible="False"
				Visibility="Collapsed" />
			<ContentPresenter
				x:Name="ContentPresenter"
				Padding="{TemplateBinding Padding}"
				HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
				VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
				Background="{TemplateBinding Background}"
				Content="{TemplateBinding Content}"
				ContentTemplate="{TemplateBinding ContentTemplate}"
				ContentTransitions="{TemplateBinding ContentTransitions}" />
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundPointerOver}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundPressed}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Selected">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundSelected}" />
							<Setter Target="SelectionIndicator.Visibility" Value="Visible" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PointerOverSelected">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundSelectedPointerOver}" />
							<Setter Target="SelectionIndicator.Visibility" Value="Visible" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PressedSelected">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundSelectedPressed}" />
							<Setter Target="SelectionIndicator.Visibility" Value="Visible" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>
		</Grid>
	</ControlTemplate>

	<!--  GridViewItem template: Uno's default presenter paints no selected or hover background, so draw them here  -->
	<ControlTemplate x:Key="Files.GridViewItemTemplate" TargetType="GridViewItem">
		<Grid x:Name="RootGrid" Background="Transparent">
			<Border
				x:Name="SelectionBackground"
				Margin="2,1"
				Background="Transparent"
				BorderBrush="Transparent"
				BorderThickness="1"
				CornerRadius="{TemplateBinding CornerRadius}"
				IsHitTestVisible="False" />
			<ContentPresenter
				x:Name="ContentPresenter"
				Padding="{TemplateBinding Padding}"
				HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
				VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
				Background="{TemplateBinding Background}"
				Foreground="{ThemeResource TextFillColorPrimaryBrush}"
				Content="{TemplateBinding Content}"
				ContentTemplate="{TemplateBinding ContentTemplate}"
				ContentTransitions="{TemplateBinding ContentTransitions}" />
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundPointerOver}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Item.BackgroundPressed}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Selected">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Tile.BackgroundSelected}" />
							<Setter Target="SelectionBackground.BorderBrush" Value="{ThemeResource Files.Tile.BorderSelected}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PointerOverSelected">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Tile.BackgroundSelectedPointerOver}" />
							<Setter Target="SelectionBackground.BorderBrush" Value="{ThemeResource Files.Tile.BorderSelected}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PressedSelected">
						<VisualState.Setters>
							<Setter Target="SelectionBackground.Background" Value="{ThemeResource Files.Tile.BackgroundSelectedPressed}" />
							<Setter Target="SelectionBackground.BorderBrush" Value="{ThemeResource Files.Tile.BorderSelected}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>
		</Grid>
	</ControlTemplate>

	<ResourceDictionary.ThemeDictionaries>
		<!--  No Mica on Linux: the window backdrop is a solid fill equal to the Mica base colour, so the translucent Files layers on top keep their look  -->
		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="#FAFAFA" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#0F000000" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#0A000000" />
			<SolidColorBrush x:Key="Files.Linux.FlyoutSurfaceBrush" Color="#F9F9F9" />
			<SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#33000000" />
			<SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#33000000" />
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="#F3F3F3" />
			<SolidColorBrush x:Key="Files.Item.AccentBrush" Color="{ThemeResource SystemAccentColor}" />
			<SolidColorBrush x:Key="Files.Item.BackgroundPointerOver" Color="#0A000000" />
			<SolidColorBrush x:Key="Files.Item.BackgroundPressed" Color="#06000000" />
			<SolidColorBrush x:Key="Files.Item.BackgroundSelected" Color="#14000000" />
			<SolidColorBrush x:Key="Files.Item.BackgroundSelectedPointerOver" Color="#1A000000" />
			<SolidColorBrush x:Key="Files.Item.BackgroundSelectedPressed" Color="#10000000" />
			<SolidColorBrush x:Key="Files.Item.BorderSelected" Color="Transparent" />
			<SolidColorBrush x:Key="Files.Tile.BackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
			<SolidColorBrush x:Key="Files.Tile.BackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
			<SolidColorBrush x:Key="Files.Tile.BackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
			<SolidColorBrush x:Key="Files.Tile.BorderSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.5" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#14FFFFFF" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#0DFFFFFF" />
			<SolidColorBrush x:Key="Files.Linux.FlyoutSurfaceBrush" Color="#2B2B2B" />
			<SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#26FFFFFF" />
			<SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#26FFFFFF" />
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="#202020" />
			<SolidColorBrush x:Key="Files.Item.AccentBrush" Color="{ThemeResource SystemAccentColor}" />
			<SolidColorBrush x:Key="Files.Item.BackgroundPointerOver" Color="#0FFFFFFF" />
			<SolidColorBrush x:Key="Files.Item.BackgroundPressed" Color="#0AFFFFFF" />
			<SolidColorBrush x:Key="Files.Item.BackgroundSelected" Color="#1AFFFFFF" />
			<SolidColorBrush x:Key="Files.Item.BackgroundSelectedPointerOver" Color="#22FFFFFF" />
			<SolidColorBrush x:Key="Files.Item.BackgroundSelectedPressed" Color="#14FFFFFF" />
			<SolidColorBrush x:Key="Files.Item.BorderSelected" Color="Transparent" />
			<SolidColorBrush x:Key="Files.Tile.BackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.28" />
			<SolidColorBrush x:Key="Files.Tile.BackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.34" />
			<SolidColorBrush x:Key="Files.Tile.BackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
			<SolidColorBrush x:Key="Files.Tile.BorderSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.6" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
