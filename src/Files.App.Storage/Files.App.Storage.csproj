<Project Sdk="Uno.Sdk">

    <PropertyGroup>
        <DisableImplicitUnoPackages>true</DisableImplicitUnoPackages>
        <UnoSingleProject>false</UnoSingleProject>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <Configurations>Debug;Release</Configurations>
        <Platforms>x86;x64;arm64</Platforms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
        <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Uno.WinUI" />
        <PackageReference Include="FluentFTP" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Files.Core.Storage\Files.Core.Storage.csproj" />
        <ProjectReference Include="..\Files.Shared\Files.Shared.csproj" />
        <ProjectReference Include="..\Files.Platform.Abstractions\Files.Platform.Abstractions.csproj" />
    </ItemGroup>

</Project>
