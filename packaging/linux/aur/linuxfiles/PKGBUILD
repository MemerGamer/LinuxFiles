# Upstream: Files by Files Community (https://github.com/files-community/Files); this is the unofficial LinuxFiles fork.
# Developer: LinuxFiles contributors (fork of Files by Files Community)
# Maintainer: MemerGamer <kovacsbalinthunor13@gmail.com>
pkgname=linuxfiles
pkgver=0.1.0
pkgrel=1
pkgdesc='LinuxFiles, Files for Linux: unofficial port of Files by the Files Community (Uno Platform)'
arch=('x86_64' 'aarch64')
url='https://github.com/MemerGamer/LinuxFiles'
license=('MIT')
# Self-contained publish bundles the runtime; native libs below are loaded by Skia/Uno at runtime.
depends=('fontconfig' 'freetype2' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'libxext' 'wayland' 'libxkbcommon' 'libglvnd' 'mesa' 'glib2' 'hicolor-icon-theme')
makedepends=('dotnet-sdk>=10.0' 'git' 'clang' 'zlib' 'python')
optdepends=('polkit: authenticated root actions' 'gvfs: network and MTP locations' 'gnome-disk-utility: format and manage drives' 'mpv: audio and video playback in the preview pane' 'webkit2gtk-4.1: rendered HTML previews')
options=('!strip')  # .NET single-file/self-contained binaries break when stripped
# Generated from build/uno-wayland-packages.sha256; templates require complete pins.
_uno_version=6.7.135-wayland.7
_uno_base="https://github.com/MemerGamer/uno/releases/download/uno-wayland-$_uno_version"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/linux-v$pkgver.tar.gz"
  "$_uno_base/Uno.WinUI.$_uno_version.nupkg"
  "$_uno_base/Uno.WinRT.$_uno_version.nupkg"
  "$_uno_base/Uno.Foundation.$_uno_version.nupkg"
  "$_uno_base/Uno.Foundation.Logging.$_uno_version.nupkg"
  "$_uno_base/Uno.UI.Adapter.Microsoft.Extensions.Logging.$_uno_version.nupkg"
  "$_uno_base/Uno.WinUI.Runtime.Skia.$_uno_version.nupkg"
  "$_uno_base/Uno.WinUI.Runtime.Skia.X11.$_uno_version.nupkg"
  "$_uno_base/Uno.WinUI.Runtime.Skia.Wayland.$_uno_version.nupkg"
)
noextract=(
  "Uno.WinUI.$_uno_version.nupkg"
  "Uno.WinRT.$_uno_version.nupkg"
  "Uno.Foundation.$_uno_version.nupkg"
  "Uno.Foundation.Logging.$_uno_version.nupkg"
  "Uno.UI.Adapter.Microsoft.Extensions.Logging.$_uno_version.nupkg"
  "Uno.WinUI.Runtime.Skia.$_uno_version.nupkg"
  "Uno.WinUI.Runtime.Skia.X11.$_uno_version.nupkg"
  "Uno.WinUI.Runtime.Skia.Wayland.$_uno_version.nupkg"
)
sha256sums=('UNGENERATED' 'UNGENERATED' 'UNGENERATED' 'UNGENERATED' 'UNGENERATED' 'UNGENERATED' 'UNGENERATED' 'UNGENERATED' 'UNGENERATED')

build() {
  cd "LinuxFiles-linux-v$pkgver"
  case "$CARCH" in
    x86_64) _rid=linux-x64 ;;
    aarch64) _rid=linux-arm64 ;;
  esac
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  build/fetch-uno-wayland.sh --from "$srcdir"
  build/clear-uno-wayland-cache.sh
  MSBUILDDISABLENODEREUSE=1 nice -n 19 dotnet publish src/Files.App/Files.App.csproj \
    -f net10.0-desktop -c Release -r "$_rid" --self-contained \
    -p:PublishTrimmed=false -p:PublishAot=false \
    -nodeReuse:false -m:2 -o "$srcdir/publish"
  MSBUILDDISABLENODEREUSE=1 nice -n 19 dotnet publish \
    src/Files.Platform.Linux.ElevationHelper/Files.Platform.Linux.ElevationHelper.csproj \
    -c Release -r "$_rid" --self-contained -nodeReuse:false -m:2 -o "$srcdir/helper"
}

package() {
  cd "LinuxFiles-linux-v$pkgver"
  local id=io.github.memergamer.LinuxFiles

  install -dm755 "$pkgdir/usr/lib/linuxfiles"
  cp -a "$srcdir/publish/." "$pkgdir/usr/lib/linuxfiles/"
  install -Dm755 "$srcdir/helper/files-elevation-helper" "$pkgdir/usr/lib/linuxfiles/files-elevation-helper"
  install -Dm644 packaging/linux/io.github.memergamer.LinuxFiles.root-actions.policy \
    "$pkgdir/usr/share/polkit-1/actions/io.github.memergamer.LinuxFiles.root-actions.policy"
  # The launcher finds /usr/lib/linuxfiles/Files.dll on its own.
  install -Dm755 packaging/linux/files "$pkgdir/usr/bin/files"

  install -Dm644 "packaging/linux/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "packaging/linux/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/linux/icons/hicolor/${s}x${s}/apps/$id.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$id.png"
  done
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}

# This checked-in template is intentionally not consumable by makepkg.
if [[ " ${sha256sums[*]} " == *UNGENERATED* ]]; then
  printf '%s\n' 'Generate a checksum-pinned recipe with scripts/linux/gen-aur.sh before building.' >&2
  return 1 2>/dev/null || exit 1
fi
