<?xml version="1.0" encoding="utf-8"?>
<!--  Used only with -p:UseUnoWayland=true. Mirrors nuget.config and maps the forked Uno packages to a local feed built by
      MemerGamer/uno build/wayland/build-local-packages.sh. Pass -p:RestoreConfigFile=... to use a feed elsewhere.  -->
<configuration>
  <packageSources>
    <clear />
    <add key="NuGet Gallery" value="https://api.nuget.org/v3/index.json" />
    <add key="Project Packages" value="src/Files.App/Assets/Libraries/" />
    <add key="Toolkit Labs" value="https://pkgs.dev.azure.com/dotnet/CommunityToolkit/_packaging/CommunityToolkit-Labs/nuget/v3/index.json" />
    <add key="Uno Wayland" value="%HOME%/.cache/uno-wayland-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Project Packages">
      <package pattern="SevenZipSharp" />
      <package pattern="LibGit2Sharp*" />
    </packageSource>
    <packageSource key="Toolkit Labs">
      <package pattern="CommunityToolkit.Labs.*" />
    </packageSource>
    <packageSource key="Uno Wayland">
      <package pattern="Uno.WinUI" />
      <package pattern="Uno.WinRT" />
      <package pattern="Uno.Foundation" />
      <package pattern="Uno.Foundation.Logging" />
      <package pattern="Uno.UI.Adapter.Microsoft.Extensions.Logging" />
      <package pattern="Uno.WinUI.Runtime.Skia" />
      <package pattern="Uno.WinUI.Runtime.Skia.X11" />
      <package pattern="Uno.WinUI.Runtime.Skia.Wayland" />
    </packageSource>
    <packageSource key="NuGet Gallery">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
