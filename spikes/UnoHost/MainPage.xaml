<Page
    x:Class="UnoHost.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Files.App.Controls"
    xmlns:local="using:UnoHost"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="8" Padding="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ListStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="FileList.Padding" Value="0" />
                        <Setter Target="HeaderText.Text" Value="Compact state active" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Omnibar + BreadcrumbBar  -->
        <controls:Omnibar x:Name="Omnibar" Grid.Row="0" CurrentSelectedModeName="Path">
            <controls:OmnibarMode
                x:Name="PathMode"
                IsDefault="True"
                ModeName="Path"
                PlaceholderText="Type a path"
                Text="/home/user/Documents"
                TextMemberPath="Title">
                <controls:OmnibarMode.ContentOnInactive>
                    <controls:BreadcrumbBar x:Name="Breadcrumb" ItemsSource="{x:Bind PathItems}">
                        <controls:BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="local:PathItem">
                                <controls:BreadcrumbBarItem
                                    Content="{x:Bind Title, Mode=OneTime}"
                                    IsChevronVisible="True" />
                            </DataTemplate>
                        </controls:BreadcrumbBar.ItemTemplate>
                    </controls:BreadcrumbBar>
                </controls:OmnibarMode.ContentOnInactive>
            </controls:OmnibarMode>
        </controls:Omnibar>

        <!--  Toolbar  -->
        <controls:Toolbar x:Name="MainToolbar" Grid.Row="1" ToolbarSize="Medium">
            <controls:Toolbar.Items>
                <controls:ToolbarItem
                    IconSize="16"
                    ItemType="Button"
                    Label="Cut"
                    OverflowBehavior="Auto"
                    ThemedIcon="{StaticResource App.ThemedIcons.Cut}" />
                <controls:ToolbarItem
                    IconSize="16"
                    ItemType="Button"
                    Label="Copy"
                    OverflowBehavior="Auto"
                    ThemedIcon="{StaticResource App.ThemedIcons.Copy}" />
                <controls:ToolbarItem ItemType="Separator" OverflowBehavior="Auto" />
                <controls:ToolbarItem
                    IconSize="16"
                    IsChecked="True"
                    ItemType="ToggleButton"
                    Label="Toggle"
                    OverflowBehavior="Auto"
                    ThemedIcon="{StaticResource App.ThemedIcons.Folder}" />
            </controls:Toolbar.Items>
            <controls:Toolbar.ItemTemplate>
                <DataTemplate x:DataType="controls:IToolbarItemSet">
                    <ContentPresenter Content="{x:Bind}" />
                </DataTemplate>
            </controls:Toolbar.ItemTemplate>
        </controls:Toolbar>

        <!--  Sidebar with inner content  -->
        <controls:SidebarView
            x:Name="Sidebar"
            Grid.Row="2"
            DisplayMode="Expanded"
            IsPaneOpen="True"
            MenuItemsSource="{x:Bind SidebarItems}"
            OpenPaneLength="220">
            <controls:SidebarView.InnerContent>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabView
                        x:Name="Tabs"
                        Grid.Row="0"
                        IsAddTabButtonVisible="True"
                        AddTabButtonClick="Tabs_AddTabButtonClick"
                        TabCloseRequested="Tabs_TabCloseRequested">
                        <TabViewItem Header="Documents" IsClosable="True" />
                        <TabViewItem Header="Downloads" IsClosable="True" />
                    </TabView>

                    <Grid Grid.Row="1" x:Name="ListHost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="HeaderText" Text="Normal state" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="CompactToggle" Content="Toggle VSM" Click="CompactToggle_Click" />
                            <ToggleButton x:Name="LoadToggle" Content="x:Load footer" IsChecked="{x:Bind FooterLoaded, Mode=TwoWay}" />
                        </StackPanel>

                        <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind Files}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileRow">
                                    <Grid ColumnSpacing="12" Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            x:Name="LoadedFooter"
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            x:Load="{x:Bind FooterLoaded, Mode=OneWay}"
                            Text="x:Load footer realized" />
                    </Grid>
                </Grid>
            </controls:SidebarView.InnerContent>
        </controls:SidebarView>
    </Grid>
</Page>
