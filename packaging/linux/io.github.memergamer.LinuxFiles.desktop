# DBusActivatable is deliberately not set. Files claims io.github.memergamer.LinuxFiles itself at startup and a second
# launch forwards its command line to the running instance (org.freedesktop.Application is implemented for other
# callers such as `gio open`/`gdbus call`, but the bus does not start Files). Making it activatable needs a D-Bus
# .service file per package format and gains nothing over `Exec=files %U` today.
# org.freedesktop.FileManager1 is also not activatable: it is only offered while Files runs and the user enabled
# "Use Files as the default file manager"; other file managers keep working otherwise.
[Desktop Entry]
Type=Application
Name=LinuxFiles
GenericName=File Manager
Comment=Browse and manage files and folders
Exec=files %U
Icon=io.github.memergamer.LinuxFiles
Terminal=false
StartupNotify=true
StartupWMClass=Files
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
Keywords=files;folders;directory;explorer;browse;manager;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=files --new-window
