<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ByteSize" Version="2.1.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.ColorPicker" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Triggers" Version="8.2.251219" />
    <PackageVersion Include="DiscUtils.Udf" Version="0.16.13" />
    <PackageVersion Include="FluentFTP" Version="55.0.0" />
    <PackageVersion Include="LibGit2Sharp" Version="0.999.32" />
    <PackageVersion Include="MessageFormat" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="OwlCore.Storage" Version="0.15.0" />
    <PackageVersion Include="Sentry" Version="6.11.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
    <PackageVersion Include="Svg.Skia" Version="3.7.0" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.0" />
    <PackageVersion Include="Uno.WinUI" Version="6.7.135" />
    <PackageVersion Include="Uno.WinUI.Runtime.Skia.X11" Version="6.7.135" />
    <PackageVersion Include="Uno.Microsoft.Xaml.Behaviors.WinUI.Managed" Version="2.4.2" />
    <PackageVersion Include="UTF.Unknown" Version="2.7.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Markdig" Version="0.38.0" />
    <PackageVersion Include="ColorCode.Core" Version="2.0.15" />
  </ItemGroup>
  <!--  Native Wayland host from the MemerGamer/uno fork; see docs/linux-port/wayland-packages.md  -->
  <PropertyGroup>
    <UnoWaylandVersion Condition="'$(UnoWaylandVersion)' == ''">6.7.135-wayland.4</UnoWaylandVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FilesUseUnoWayland)' == 'true'">
    <RestoreConfigFile Condition="'$(RestoreConfigFile)' == ''">$(MSBuildThisFileDirectory)nuget.wayland.config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(FilesUseUnoWayland)' == 'true'">
    <PackageVersion Update="Uno.WinUI" Version="$(UnoWaylandVersion)" />
    <PackageVersion Update="Uno.WinUI.Runtime.Skia.X11" Version="$(UnoWaylandVersion)" />
    <PackageVersion Include="Uno.WinUI.Runtime.Skia.Wayland" Version="$(UnoWaylandVersion)" />
  </ItemGroup>
  <!--  Uno.Sdk rejects any Uno.WinUI other than its own release (UNOB0005); allow only the reviewed fork cohort with its unchanged 6.7.135 SDK base.
       Runs before UnoSdkVersionCheck evaluates its condition, which is the only user of PkgUno_WinUI.  -->
  <Target Name="_FilesAllowUnoWaylandPackages" BeforeTargets="BeforeBuild;ResolveReferences" Condition="'$(FilesUseUnoWayland)' == 'true' And '$(UnoWaylandVersion)' == '6.7.135-wayland.4' And '$(UnoVersion)' == '6.7.135' And $([System.IO.Path]::GetFileName($(PkgUno_WinUI))) == '$(UnoWaylandVersion)'">
    <PropertyGroup>
      <PkgUno_WinUI />
    </PropertyGroup>
  </Target>
</Project>
