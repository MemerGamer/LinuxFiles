<vm:BasePropertiesPage
	x:Class="Files.App.Views.Properties.PermissionsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:toolkitconverters="using:CommunityToolkit.WinUI.Converters"
	xmlns:vm="using:Files.App.ViewModels.Properties"
	Tag="Permissions"
	mc:Ignorable="d">

	<vm:BasePropertiesPage.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ms-appx:///Styles/PropertiesStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<toolkitconverters:BoolNegationConverter x:Key="BoolNegationConverter" />
		</ResourceDictionary>
	</vm:BasePropertiesPage.Resources>

	<ScrollViewer>
		<StackPanel Padding="12" Spacing="4">

			<InfoBar
				IsClosable="False"
				IsOpen="{x:Bind PermissionsViewModel.IsReadOnlyNoteVisible, Mode=OneWay}"
				Message="{helpers:ResourceString Key=PropertiesPermissionsReadOnlyNote}"
				Severity="Informational" />

			<!--  Owner and group  -->
			<Grid
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				ColumnSpacing="8"
				CornerRadius="4"
				RowSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto"
						MinWidth="100"
						MaxWidth="140" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					VerticalAlignment="Center"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Key=PropertiesPermissionsOwnerLabel}" />
				<TextBox
					x:Name="OwnerTextBox"
					Grid.Row="0"
					Grid.Column="1"
					VerticalAlignment="Center"
					IsReadOnly="{x:Bind PermissionsViewModel.CanChangeOwner, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
					Text="{x:Bind PermissionsViewModel.OwnerName, Mode=TwoWay}" />

				<TextBlock
					Grid.Row="1"
					VerticalAlignment="Center"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Key=PropertiesPermissionsGroupLabel}" />
				<TextBox
					x:Name="GroupTextBox"
					Grid.Row="1"
					Grid.Column="1"
					VerticalAlignment="Center"
					IsReadOnly="{x:Bind PermissionsViewModel.CanChangeOwner, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
					Text="{x:Bind PermissionsViewModel.GroupName, Mode=TwoWay}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="1"
					Opacity="0.7"
					Text="{helpers:ResourceString Key=PropertiesPermissionsOwnerReadOnlyNote}"
					TextWrapping="Wrap"
					Visibility="{x:Bind PermissionsViewModel.IsOwnerNoteVisible, Mode=OneWay}" />
			</Grid>

			<!--  Permission bits  -->
			<Grid
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				ColumnSpacing="8"
				CornerRadius="4"
				RowSpacing="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Width="90"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Key=PropertiesPermissionsRead}" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="2"
					Width="90"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Key=PropertiesPermissionsWrite}" />
				<TextBlock
					Grid.Row="0"
					Grid.Column="3"
					Width="90"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Key=PropertiesPermissionsExecute}" />

				<TextBlock
					Grid.Row="1"
					VerticalAlignment="Center"
					Text="{helpers:ResourceString Key=PropertiesPermissionsOwnerGroup}" />
				<CheckBox
					x:Name="OwnerReadCheckBox"
					Grid.Row="1"
					Grid.Column="1"
					MinWidth="0"
					AutomationProperties.Name="Owner read"
					IsChecked="{x:Bind PermissionsViewModel.OwnerRead, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
				<CheckBox
					x:Name="OwnerWriteCheckBox"
					Grid.Row="1"
					Grid.Column="2"
					MinWidth="0"
					AutomationProperties.Name="Owner write"
					IsChecked="{x:Bind PermissionsViewModel.OwnerWrite, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
				<CheckBox
					x:Name="OwnerExecuteCheckBox"
					Grid.Row="1"
					Grid.Column="3"
					MinWidth="0"
					AutomationProperties.Name="Owner execute"
					IsChecked="{x:Bind PermissionsViewModel.OwnerExecute, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />

				<TextBlock
					Grid.Row="2"
					VerticalAlignment="Center"
					Text="{helpers:ResourceString Key=PropertiesPermissionsGroupGroup}" />
				<CheckBox
					x:Name="GroupReadCheckBox"
					Grid.Row="2"
					Grid.Column="1"
					MinWidth="0"
					AutomationProperties.Name="Group read"
					IsChecked="{x:Bind PermissionsViewModel.GroupRead, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
				<CheckBox
					x:Name="GroupWriteCheckBox"
					Grid.Row="2"
					Grid.Column="2"
					MinWidth="0"
					AutomationProperties.Name="Group write"
					IsChecked="{x:Bind PermissionsViewModel.GroupWrite, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
				<CheckBox
					x:Name="GroupExecuteCheckBox"
					Grid.Row="2"
					Grid.Column="3"
					MinWidth="0"
					AutomationProperties.Name="Group execute"
					IsChecked="{x:Bind PermissionsViewModel.GroupExecute, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />

				<TextBlock
					Grid.Row="3"
					VerticalAlignment="Center"
					Text="{helpers:ResourceString Key=PropertiesPermissionsOthersGroup}" />
				<CheckBox
					x:Name="OtherReadCheckBox"
					Grid.Row="3"
					Grid.Column="1"
					MinWidth="0"
					AutomationProperties.Name="Others read"
					IsChecked="{x:Bind PermissionsViewModel.OtherRead, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
				<CheckBox
					x:Name="OtherWriteCheckBox"
					Grid.Row="3"
					Grid.Column="2"
					MinWidth="0"
					AutomationProperties.Name="Others write"
					IsChecked="{x:Bind PermissionsViewModel.OtherWrite, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
				<CheckBox
					x:Name="OtherExecuteCheckBox"
					Grid.Row="3"
					Grid.Column="3"
					MinWidth="0"
					AutomationProperties.Name="Others execute"
					IsChecked="{x:Bind PermissionsViewModel.OtherExecute, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
			</Grid>

			<!--  Executable toggle (files)  -->
			<Grid
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="4"
				Visibility="{x:Bind PermissionsViewModel.IsFile, Mode=OneWay}">
				<ToggleSwitch
					x:Name="ExecutableToggle"
					AutomationProperties.Name="{helpers:ResourceString Key=PropertiesPermissionsAllowExecuting}"
					Header="{helpers:ResourceString Key=PropertiesPermissionsAllowExecuting}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}"
					IsOn="{x:Bind PermissionsViewModel.IsExecutable, Mode=TwoWay}" />
			</Grid>

			<!--  Recursive apply (folders)  -->
			<Grid
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="4"
				Visibility="{x:Bind PermissionsViewModel.IsDirectory, Mode=OneWay}">
				<CheckBox
					x:Name="RecursiveCheckBox"
					Content="{helpers:ResourceString Key=PropertiesPermissionsApplyRecursive}"
					IsChecked="{x:Bind PermissionsViewModel.ApplyRecursively, Mode=TwoWay}"
					IsEnabled="{x:Bind PermissionsViewModel.CanChangeMode, Mode=OneWay}" />
			</Grid>

		</StackPanel>
	</ScrollViewer>
</vm:BasePropertiesPage>
