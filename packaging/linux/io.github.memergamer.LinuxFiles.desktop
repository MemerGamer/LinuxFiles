[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and manage files and folders
Exec=files %U
Icon=io.github.memergamer.LinuxFiles
Terminal=false
StartupNotify=true
StartupWMClass=Files
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
Keywords=files;folders;directory;explorer;browse;manager;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=files
