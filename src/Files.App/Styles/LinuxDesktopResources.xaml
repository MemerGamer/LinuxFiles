<!--
	Linux desktop (Uno Skia) resource overrides. Merged last in App.xaml so they win over the WinUI defaults.
	Segoe UI / Segoe Fluent Icons are not redistributable, so text uses the OFL-licensed Selawik (Segoe UI metrics)
	and icons use Uno.Fonts.Fluent (Segoe Fluent Icons code points). See docs/linux-port/third-party-fonts.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<FontFamily x:Key="ContentControlThemeFontFamily">Selawik, Segoe UI, Noto Sans, DejaVu Sans</FontFamily>
	<FontFamily x:Key="SymbolThemeFontFamily">ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf#Symbols</FontFamily>
	<FontFamily x:Key="Files.Linux.IconFontFamily">ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf#Symbols</FontFamily>
	<FontFamily x:Key="Files.Linux.MonospaceFontFamily">DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>

	<ResourceDictionary.ThemeDictionaries>
		<!--  No Mica on Linux: the window backdrop is a solid fill equal to the Mica base colour, so the translucent Files layers on top keep their look  -->
		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="#F3F3F3" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="#202020" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
